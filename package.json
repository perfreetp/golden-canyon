{
  "name": "neurosurg-consult-platform",
  "version": "1.0.0",
  "private": true,
  "description": "神经外科术前谈话图示编辑与发布平台（原生 TypeScript + Web Components + Babylon.js）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:geometry": "node --experimental-strip-types tests/geometry.test.ts",
    "test:bool": "node --experimental-strip-types tests/bool-e2e.ts",
    "test:smoke": "node --experimental-strip-types tests/cdp-smoke.ts",
    "test:interaction": "node --experimental-strip-types tests/cdp-interaction.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.36.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
